# ============================================================
# Orbit — Environment Variables Template
# ============================================================
# Copy this file to .env (never commit .env to source control)
# Fill in your actual values before running the server.
# ============================================================

# --- Runtime & Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Neon pooled connection string (use pooler URL for production)
DATABASE_URL=postgresql://neondb_owner:npg_BM7IDyiSCE6Z@ep-lively-morning-bd28t86r.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Authentication & Sessions ---
# Cryptographic secret for signing session cookies (min 32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=8f3c2a91d7e64b0f5a8c1d3e9b72f604c1a5e8d93f0b6c2a7d4e1f8b5c9a6302

# Cryptographic secret for HMAC-SHA256 hashing of session tokens in database (min 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=b6e1d9a43c7f2058e2a6b0d91f4c8357a9e3d1b6c8f2045a7d2e9c1b5f6038a4

# Cost factor for bcrypt password hashing (default: 12)
BCRYPT_ROUNDS=12

# --- CORS & Security ---
# Comma-separated allowed frontend origins (no trailing slashes)
CORS_ORIGIN=http://localhost:3000

# --- Rate Limiting ---
# Window in milliseconds (default: 15 minutes = 900000)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP (auth endpoints)
AUTH_RATE_LIMIT_MAX=100

# --- Real-Time & Cache (Optional until Socket.IO Bonus Phase) ---
# Upstash or standard Redis connection URL for cross-instance Socket.IO coordination
REDIS_URL=redis://default:token@region.upstash.io:6379
