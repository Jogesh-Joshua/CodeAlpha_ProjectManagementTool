{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/socket-io/:path*",
      "destination": "/api/socket-io.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
